# Postgres container credentials (used by docker-compose.yml)
POSTGRES_USER=technotopia
POSTGRES_PASSWORD=changeme
POSTGRES_DB=technotopia

# Prisma connection string — keep in sync with the POSTGRES_* values above
# (port 5433, not 5432 — see docker-compose.yml)
DATABASE_URL="postgresql://technotopia:changeme@localhost:5433/technotopia?schema=public"

# Auth
JWT_SECRET=changeme
COOKIE_NAME=technotopia_session

# Environment
NODE_ENV=development

# Storefront canonical site URL — used for absolute URLs in structured data (JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Blob — only read on Vercel previews (VERCEL env var is set automatically
# there). The real deployment (Docker/VPS, see DEPLOYMENT.md) writes uploads to
# the local `public/uploads` volume instead and doesn't need this.
# BLOB_READ_WRITE_TOKEN=
