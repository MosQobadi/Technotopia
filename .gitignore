# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor
.vscode/*
!.vscode/extensions.json
.idea

/lib/generated/prisma

# user-uploaded content (written at runtime, not source)
/public/uploads

# uploads bind-mount target on the VPS (docker-compose.prod.yml), plus the
# database dumps and archives used to move real data there — never source
/uploads
/backups
*.dump

# certbot state (certs, account keys) — generated on the VPS, not source
/certbot

# the activated HTTPS server block — a copy of nginx/conf.d/https.conf.disabled
# carrying the real domain and cert paths, made on the VPS (DEPLOYMENT.md §5)
/nginx/conf.d/https.conf

# playwright
/e2e/.auth
/playwright-report
/test-results
/blob-report

# claude code — personal local permissions, not shared config
.claude/settings.local.json

# graphify — generated knowledge-graph output, not source
/graphify-out
